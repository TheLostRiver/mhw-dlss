+static std::atomic<unsigned> mhwSwapchainWaitCalls { 0 };
+static std::atomic<unsigned> mhwSwapchainWaitBypassed { 0 };
+
+static void MhwLogPresentTiming(bool enabled, int backend, double frameMs, double fgWorkMs,
+                                double presentMs, double sleepMs, double limiterMs)
+{
+    if (!FgPresentIsMhwProcess() || !Config::Instance()->LogToFile.value_or_default())
+        return;
+    struct Samples
+    {
+        bool enabled = false;
+        int backend = -1;
+        unsigned count = 0;
+        double frames = 0, fgWork = 0, present = 0, sleep = 0, limiter = 0, swapWait = 0;
+        unsigned waitCalls = 0, waitBypassed = 0;
+        std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+    };
+    static thread_local Samples samples;
+    const auto now = std::chrono::steady_clock::now();
+    if (samples.enabled != enabled || samples.backend != backend)
+    {
+        samples = {};
+        samples.enabled = enabled;
+        samples.backend = backend;
+        samples.start = now;
+    }
+    samples.count++;
+    samples.frames += frameMs;
+    samples.fgWork += fgWorkMs;
+    samples.present += presentMs;
+    samples.sleep += sleepMs;
+    samples.limiter += limiterMs;
+    samples.swapWait += mhwSwapchainWaitNs.exchange(0, std::memory_order_relaxed) / 1'000'000.0;
+    samples.waitCalls += mhwSwapchainWaitCalls.exchange(0, std::memory_order_relaxed);
+    samples.waitBypassed += mhwSwapchainWaitBypassed.exchange(0, std::memory_order_relaxed);
+    if (now - samples.start >= std::chrono::seconds(3))
+    {
+        LOG_INFO("[MHWFG timing] fg_active={} backend={} samples={} app_fps={:.1f} frame_ms={:.3f} "
+                 "fg_work_ms={:.3f} present_ms={:.3f} reflex_sleep_ms={:.3f} limiter_ms={:.3f} "
+                 "game_wait_ms={:.3f} wait_calls={} wait_bypassed={} generated_frames={}",
+                 enabled, backend, samples.count, samples.frames > 0 ? 1000.0 * samples.count / samples.frames : 0.0,
+                 samples.frames / samples.count, samples.fgWork / samples.count, samples.present / samples.count,
+                 samples.sleep / samples.count, samples.limiter / samples.count, samples.swapWait / samples.count,
+                 samples.waitCalls, samples.waitBypassed, State::Instance().dlssgDetectedInterpolationCount);
+        samples.count = 0;
+        samples.frames = samples.fgWork = samples.present = samples.sleep = samples.limiter = samples.swapWait = 0;
+        samples.waitCalls = samples.waitBypassed = 0;
+        samples.start = now;
+    }
+}
